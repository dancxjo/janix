# Build outputs
/target
/**/target
*.iso
*.hdd
iso_root*/
*.log
*.pid
/build

# rustc-thingos build cache (produced by `just rustc-thingos` / `just iso`)
/target/rustc-thingos/

temp_*.txt
/*.py

# Vendor dependencies (fetched by `just fetch`)
# vendor/rust/ is tracked as a git submodule — not ignored here
/vendor/limine/
/vendor/ovmf/
/vendor/future-cursors/

# Fetched assets (managed by `just fetch`)
# NOTE: /assets/wallpapers/ is tracked - must come before the ignore
!/assets/wallpapers/
/assets/cursors/
/assets/fonts/
!/assets/icons/
/assets/icons/tango/
/assets/pci/

# Bran binaries
/bran/bin-*

*_log*.txt
qemu_pid
kernel/errors.txt
patch*.py

# Reproducible upstream snapshot for the Thing-OS smallsh port
/userspace/smallsh/upstream/
