@@ -0,0 +1,99 @@
+//! ThingOS stdio implementation.
+//!
+//! File descriptors 0, 1, 2 are pre-populated by the kernel at spawn time
+//! (see kernel/src/sched/spawn.rs `setup_stdio_fds`).
+//!
+//! Reads/writes go through `SYS_READ` (0x1400) and `SYS_WRITE` (0x1401)
+//! which are the basic fd-based I/O syscalls that work for all fds including
+//! the pre-populated stdio fds.
+//!
+//! `STDIN_BUF_SIZE` is set to 1 so that line-buffered reads behave correctly
+//! on a serial/console input that delivers bytes one at a time.

+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut};
+
+// Syscall numbers (abi/src/numbers.rs)
+const SYS_READ: u32 = 0x1400;
+const SYS_WRITE: u32 = 0x1401;
+const FD_STDIN: usize = 0;
+const FD_STDOUT: usize = 1;
+const FD_STDERR: usize = 2;
+
+#[inline(always)]
+unsafe fn raw_syscall6(n: u32, a0: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {
+    unsafe { crate::sys::pal::raw_syscall6(n, a0, a1, a2, a3, a4, a5) }
+}
+
+#[inline]
+fn io_err(ret: isize) -> io::Error {
+    io::Error::from_raw_os_error((-ret) as i32)
+}
+
+// ─── Stdin ────────────────────────────────────────────────────────────────────
+
+pub struct Stdin;
+
+impl Stdin {
+    pub const fn new() -> Stdin {
+        Stdin
+    }
+}
+
+impl io::Read for Stdin {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        if buf.is_empty() {
+            return Ok(0);
+        }
+        let ret = unsafe {
+            raw_syscall6(SYS_READ, FD_STDIN, buf.as_mut_ptr() as usize, buf.len(), 0, 0, 0)
+        };
+        if ret < 0 { Err(io_err(ret)) } else { Ok(ret as usize) }
+    }
+
+    fn read_buf(&mut self, mut cursor: BorrowedCursor<'_>) -> io::Result<()> {
+        let buf = cursor.ensure_init().init_mut();
+        let ret = unsafe {
+            raw_syscall6(SYS_READ, FD_STDIN, buf.as_mut_ptr() as usize, buf.len(), 0, 0, 0)
+        };
+        if ret < 0 {
+            Err(io_err(ret))
+        } else {
+            unsafe { cursor.advance_unchecked(ret as usize) };
+            Ok(())
+        }
+    }
+}
+
+// ─── Stdout ───────────────────────────────────────────────────────────────────
+
+pub struct Stdout;
+
+impl Stdout {
+    pub const fn new() -> Stdout {
+        Stdout
+    }
+}
+
+impl io::Write for Stdout {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        let ret = unsafe {
+            raw_syscall6(SYS_WRITE, FD_STDOUT, buf.as_ptr() as usize, buf.len(), 0, 0, 0)
+        };
+        if ret < 0 { Err(io_err(ret)) } else { Ok(ret as usize) }
+    }
+    fn flush(&mut self) -> io::Result<()> { Ok(()) }
+}
+
+// ─── Stderr ───────────────────────────────────────────────────────────────────
+
+pub struct Stderr;
+
+impl Stderr {
+    pub const fn new() -> Stderr {
+        Stderr
+    }
+}
+
+impl io::Write for Stderr {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        let ret = unsafe {
+            raw_syscall6(SYS_WRITE, FD_STDERR, buf.as_ptr() as usize, buf.len(), 0, 0, 0)
+        };
+        if ret < 0 { Err(io_err(ret)) } else { Ok(ret as usize) }
+    }
+    fn flush(&mut self) -> io::Result<()> { Ok(()) }
+}
+
+/// Use the default buffer size for stdin I/O.
+///
+/// Larger buffers allow more efficient block reads when stdin is connected to a pipe.
+/// For interactive serial/console use, the TTY layer handles line buffering.
+pub const STDIN_BUF_SIZE: usize = crate::sys::io::DEFAULT_BUF_SIZE;
+
+pub fn is_ebadf(err: &io::Error) -> bool {
+    err.raw_os_error() == Some(9) // EBADF
+}
+
+pub fn panic_output() -> Option<impl io::Write> {
+    Some(Stderr::new())
+}
