diff --git a/library/std/src/sys/alloc/thingos.rs b/library/std/src/sys/alloc/thingos.rs
new file mode 100644
index 00000000..cb94c337
--- /dev/null
+++ b/library/std/src/sys/alloc/thingos.rs
@@ -0,0 +1,158 @@
+#![allow(static_mut_refs)]
+
+use crate::alloc::{GlobalAlloc, Layout, System};
+use crate::ptr;
+use crate::sync::atomic::{AtomicBool, Ordering};
+use crate::sys::pal::{SYS_VM_MAP, raw_syscall6};
+
+static mut DLMALLOC: dlmalloc::Dlmalloc<Thingos> = dlmalloc::Dlmalloc::new_with_allocator(Thingos);
+
+struct Thingos;
+
+const PAGE_SIZE: usize = 4096;
+
+#[repr(transparent)]
+#[derive(Clone, Copy)]
+struct VmProt(u32);
+
+impl VmProt {
+    const READ: Self = Self(1 << 0);
+    const WRITE: Self = Self(1 << 1);
+    const USER: Self = Self(1 << 3);
+}
+
+impl core::ops::BitOr for VmProt {
+    type Output = Self;
+    fn bitor(self, rhs: Self) -> Self::Output {
+        Self(self.0 | rhs.0)
+    }
+}
+
+#[repr(transparent)]
+#[derive(Clone, Copy)]
+struct VmMapFlags(u32);
+
+impl VmMapFlags {
+    const PRIVATE: Self = Self(1 << 2);
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+enum VmBacking {
+    Anonymous {
+        #[allow(dead_code)]
+        zeroed: bool,
+    },
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct VmMapReq {
+    addr_hint: usize,
+    len: usize,
+    prot: VmProt,
+    flags: VmMapFlags,
+    backing: VmBacking,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+struct VmMapResp {
+    addr: usize,
+    len: usize,
+}
+
+#[inline]
+fn align_up(v: usize, align: usize) -> usize {
+    (v + align - 1) & !(align - 1)
+}
+
+unsafe impl dlmalloc::Allocator for Thingos {
+    fn alloc(&self, size: usize) -> (*mut u8, usize, u32) {
+        let len = align_up(size.max(PAGE_SIZE), PAGE_SIZE);
+        let req = VmMapReq {
+            addr_hint: 0,
+            len,
+            prot: VmProt::READ | VmProt::WRITE | VmProt::USER,
+            flags: VmMapFlags::PRIVATE,
+            backing: VmBacking::Anonymous { zeroed: true },
+        };
+        let mut resp = VmMapResp::default();
+        let ret = unsafe {
+            raw_syscall6(
+                SYS_VM_MAP,
+                &req as *const VmMapReq as usize,
+                &mut resp as *mut VmMapResp as usize,
+                0,
+                0,
+                0,
+                0,
+            )
+        };
+        if ret < 0 || resp.addr == 0 || resp.len == 0 {
+            (ptr::null_mut(), 0, 0)
+        } else {
+            (ptr::without_provenance_mut(resp.addr), resp.len, 0)
+        }
+    }
+
+    fn remap(&self, _ptr: *mut u8, _oldsize: usize, _newsize: usize, _can_move: bool) -> *mut u8 {
+        ptr::null_mut()
+    }
+
+    fn free_part(&self, _ptr: *mut u8, _oldsize: usize, _newsize: usize) -> bool {
+        false
+    }
+
+    fn free(&self, _ptr: *mut u8, _size: usize) -> bool {
+        false
+    }
+
+    fn can_release_part(&self, _flags: u32) -> bool {
+        false
+    }
+
+    fn allocates_zeros(&self) -> bool {
+        true
+    }
+
+    fn page_size(&self) -> usize {
+        PAGE_SIZE
+    }
+}
+
+fn with_alloc<R>(f: impl FnOnce(&mut dlmalloc::Dlmalloc<Thingos>) -> R) -> R {
+    static LOCK: AtomicBool = AtomicBool::new(false);
+    while LOCK
+        .compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed)
+        .is_err()
+    {
+        core::hint::spin_loop();
+    }
+    let out = unsafe { f(&mut DLMALLOC) };
+    LOCK.store(false, Ordering::Release);
+    out
+}
+
+#[stable(feature = "alloc_system_type", since = "1.28.0")]
+unsafe impl GlobalAlloc for System {
+    #[inline]
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        with_alloc(|dl| unsafe { dl.malloc(layout.size(), layout.align()) })
+    }
+
+    #[inline]
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        with_alloc(|dl| unsafe { dl.calloc(layout.size(), layout.align()) })
+    }
+
+    #[inline]
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        with_alloc(|dl| unsafe { dl.free(ptr, layout.size(), layout.align()) })
+    }
+
+    #[inline]
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        with_alloc(|dl| unsafe { dl.realloc(ptr, layout.size(), layout.align(), new_size) })
+    }
+}
