@@ -0,0 +1,83 @@
+#![deny(unsafe_op_in_unsafe_fn)]
+
+pub mod os;
+
+// SAFETY: must be called only once during runtime initialization.
+pub unsafe fn init(_argc: isize, _argv: *const *const u8, _sigpipe: u8) {}
+
+// SAFETY: must be called only once during runtime cleanup.
+pub unsafe fn cleanup() {}
+
+pub fn unsupported<T>() -> crate::io::Result<T> {
+    Err(crate::io::Error::UNSUPPORTED_PLATFORM)
+}
+
+#[cfg(target_arch = "x86_64")]
+#[inline]
+pub(crate) unsafe fn raw_syscall6(
+    n: usize,
+    a0: usize,
+    a1: usize,
+    a2: usize,
+    a3: usize,
+    a4: usize,
+    a5: usize,
+) -> isize {
+    let ret: isize;
+    // SAFETY: caller guarantees syscall ABI correctness and argument validity.
+    unsafe {
+        core::arch::asm!(
+            "syscall",
+            in("rax") n,
+            in("rdi") a0,
+            in("rsi") a1,
+            in("rdx") a2,
+            in("r10") a3,
+            in("r8") a4,
+            in("r9") a5,
+            lateout("rax") ret,
+            lateout("rcx") _,
+            lateout("r11") _,
+            options(nostack)
+        );
+    }
+    ret
+}
+
+#[cfg(not(target_arch = "x86_64"))]
+#[inline]
+pub(crate) unsafe fn raw_syscall6(
+    _n: usize,
+    _a0: usize,
+    _a1: usize,
+    _a2: usize,
+    _a3: usize,
+    _a4: usize,
+    _a5: usize,
+) -> isize {
+    -38 // ENOSYS
+}
+
+#[inline]
+pub(crate) fn errno_or(ret: isize) -> crate::io::Result<usize> {
+    if ret < 0 {
+        Err(crate::io::Error::from_raw_os_error((-ret) as i32))
+    } else {
+        Ok(ret as usize)
+    }
+}
+
+pub const SYS_EXIT: usize = 0x01;
+pub const SYS_YIELD: usize = 0x10;
+pub const SYS_SLEEP_NS: usize = 0x11;
+pub const SYS_TIME_MONOTONIC: usize = 0x20;
+pub const SYS_TIME_NOW: usize = 0x21;
+pub const SYS_LOG_WRITE: usize = 0x31;
+pub const SYS_VM_MAP: usize = 0x41;
+
+pub fn abort_internal() -> ! {
+    unsafe {
+        let _ = raw_syscall6(SYS_EXIT, 101, 0, 0, 0, 0, 0);
+    }
+    core::intrinsics::abort()
+}
